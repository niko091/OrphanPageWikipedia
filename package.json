{
  "name": "orphanwiki-dashboard",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-web.ts",
    "heroku-build": "sh scripts/heroku-build.sh",
    "check": "tsc --noEmit && tsc -p tsconfig.node.json",
    "test": "sh scripts/prepare-fasttext.sh && cargo build --locked --bin orphanwiki && npm run build && node tests/web/dashboard.ts",
    "test:browser": "playwright test --config tests/web/playwright.config.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
